{
  "name": "soulnet-dsh-workspace",
  "private": true,
  "description": "pnpm workspace for the SoulMirror DeepSeek Harness bundle (soulnet-dsh)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "pnpm --filter soulnet-dsh run test:unit",
    "build:peer": "node scripts/build-peer-packages.mjs",
    "build:peer:current": "node scripts/build-peer-packages.mjs --current",
    "pack": "pnpm --filter soulnet-dsh pack --pack-destination ./dist",
    "pack:all": "node scripts/pack-all.mjs",
    "registry:local": "node scripts/local-registry.mjs"
  }
}
